---
import DashboardComponent from "../components/dashboard/Dashboard";
import Layout from "../layouts/Layout.astro";
import AuthLayout from "../layouts/AuthLayout";

export const prerender = false;

// Session wird bereits vom Middleware geladen - verwende locals
const session = Astro.locals.session;
if (!session) {
  return Astro.redirect('/login');
}

const sessionData: any = { user: { id: session.user.id, email: session.user.email } };
---

<Layout title="Planwise - Dashboard">
  <AuthLayout client:visible>
    <DashboardComponent client:visible session={sessionData} />
  </AuthLayout>
</Layout>
