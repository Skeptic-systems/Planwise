---
import Layout from '@/layouts/Layout.astro';
import AuthLayout from '@/layouts/AuthLayout';
import Sidebar from '@/components/dashboard/Sidebar';
import { Toaster } from '@/components/ui/feedback/toaster';
import { Archive as ArchiveList } from '@/components/dashboard/Archive';

// Session wird bereits vom Middleware geladen - verwende locals
const session = Astro.locals.session;
if (!session) {
  return Astro.redirect('/login');
}

const sessionData: any = { user: { id: session.user.id, email: session.user.email } };
---

<Layout title="Archive - Planwise">
  <AuthLayout client:visible>
    <div class="flex h-screen bg-background">
      <Sidebar session={sessionData} client:visible />
      <main class="flex-1 p-6 overflow-auto">
        <h1 class="text-3xl font-bold text-foreground mb-6">Archive</h1>
        <ArchiveList session={sessionData} client:visible />
        <Toaster client:visible />
      </main>
    </div>
  </AuthLayout>
</Layout>
