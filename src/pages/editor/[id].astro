---
import Layout from "../../layouts/Layout.astro";
import { ScheduleBoard } from "../../components/Scheduler/Core/ScheduleBoard";
import UnloadWarning from "../../components/Hooks/UnloadWarning";
import { prisma } from "@/lib/prisma";

export const prerender = false;

// Session wird bereits vom Middleware geladen - verwende locals
const session = Astro.locals.session;
if (!session) {
  return Astro.redirect('/login');
}

const sessionData: any = { user: { id: session.user.id, email: session.user.email } };
const { id } = Astro.params;
if (!id) {
  return Astro.redirect('/dashboard');
}

// Fetch plan using Drizzle ORM
const plan = await prisma.plans.findUnique({ where: { id } });

if (!plan) {
  return Astro.redirect('/dashboard');
}

// Check if user is owner or member
if (plan.user_id !== sessionData.user.id) {
  const member = await prisma.plan_members.findFirst({ where: { plan_id: id, user_id: sessionData.user.id }, select: { id: true } });
  const isMember = !!member;
  if (!isMember) {
    return Astro.redirect('/dashboard');
  }
}
---

<Layout title="Planwise - Editor">
  <main class="container mx-auto p-4 bg-black">
    <ScheduleBoard client:visible session={sessionData} plan={plan} />
  </main>
</Layout>
